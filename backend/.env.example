NODE_ENV=development
PORT=3001
API_VERSION=0.0.0
# API connection. Use the restricted runtime role (e.g. sportexus_app / academy_runtime): RLS is enforced only
# for a role without BYPASSRLS that owns no tables; production refuses to start otherwise.
DATABASE_URL=postgresql://academy:academy@localhost:5432/academy?schema=public
# Owner connection used only by the Prisma CLI (migrate/studio) when the API uses the runtime role above.
# DATABASE_ADMIN_URL=postgresql://academy:academy@localhost:5432/academy?schema=public
REDIS_URL=redis://localhost:6379

# Exact web origins allowed to send cookie-authenticated requests (CSRF check). No wildcard in production (S2).
# Development: the Next.js dev server. Production: https://<web service>.onrender.com (see docs/deployment/RENDER.md).
CORS_ORIGIN=http://localhost:3000
# Shared with the web proxy (frontend INTERNAL_PROXY_SECRET); required (>= 32 chars) in production.
# INTERNAL_PROXY_SECRET=

# =============================================================================
# SPORTEXUS EMAIL SYSTEM CONFIGURATION
# =============================================================================
# Provider selection: 'resend' | 'smtp' | 'dev'
# If left empty, auto-detects: 'resend' if RESEND_API_KEY is present,
# 'smtp' if SMTP_HOST is present, or defaults safely to 'dev' (in-memory logger).
MAIL_PROVIDER=dev

# Sender Identity
MAIL_FROM_EMAIL=no-reply@sportexus.com
MAIL_FROM_NAME="Sportexus Platform"

# Public Application URL (used for links in emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Option 1: Resend HTTP REST API
# -----------------------------------------------------------------------------
# Obtain your API key from https://resend.com/api-keys
RESEND_API_KEY=re_placeholder_secret_key

# -----------------------------------------------------------------------------
# Option 2: Standard SMTP Transport (Nodemailer)
# Works with AWS SES, SendGrid, Mailgun, Postmark, Brevo, or custom SMTP servers.
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Set to 'true' for port 465 (SSL/TLS), or 'false' for STARTTLS (port 587/2525)
SMTP_SECURE=false
SMTP_FROM=no-reply@sportexus.com
