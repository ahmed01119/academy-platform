NODE_ENV=development
PORT=3001
API_VERSION=0.0.0
# API connection. Use the restricted runtime role (e.g. sportexus_app / academy_runtime): RLS is enforced only
# for a role without BYPASSRLS that owns no tables; production refuses to start otherwise.
# Neon (serverless) sleeps when idle; append &connect_timeout=15 so the first request waits for it to wake up.
DATABASE_URL=postgresql://academy:academy@localhost:5432/academy?schema=public
# Owner connection used only by the Prisma CLI (migrate/studio) when the API uses the runtime role above.
# DATABASE_ADMIN_URL=postgresql://academy:academy@localhost:5432/academy?schema=public
REDIS_URL=redis://localhost:6379

# Exact web origins allowed to send cookie-authenticated requests (CSRF check). No wildcard in production (S2).
# Development: the Next.js dev server. Production: https://<web service>.onrender.com (see docs/deployment/RENDER.md).
CORS_ORIGIN=http://localhost:3000
# Shared with the web proxy (frontend INTERNAL_PROXY_SECRET); required (>= 32 chars) in production.
# INTERNAL_PROXY_SECRET=

# =============================================================================
# SPORTEXUS EMAIL SYSTEM CONFIGURATION
# =============================================================================
# Provider selection: 'gmail' | 'resend' | 'brevo' | 'smtp' | 'dev'
# If left empty, auto-detects: 'resend' if RESEND_API_KEY is present, 'brevo' if BREVO_API_KEY is present,
# 'gmail' if the three GMAIL_* values are present,
# 'smtp' if SMTP_HOST is present, or defaults safely to 'dev' (in-memory logger).
# Hosts that block outbound SMTP (Railway Free/Trial/Hobby) need an HTTPS provider: 'gmail', 'brevo' or 'resend'.
MAIL_PROVIDER=dev

# Sender Identity
MAIL_FROM_EMAIL=no-reply@sportexus.com
MAIL_FROM_NAME="Sportexus Platform"

# Public Application URL (used for links in emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Option 1: Resend HTTP REST API
# -----------------------------------------------------------------------------
# Obtain your API key from https://resend.com/api-keys
RESEND_API_KEY=re_placeholder_secret_key

# -----------------------------------------------------------------------------
# Option 2: Brevo HTTP API (MAIL_PROVIDER=brevo)
# -----------------------------------------------------------------------------
# API key from Brevo > SMTP & API > API keys. MAIL_FROM_EMAIL must be a verified sender in Brevo
# (Senders, domains & dedicated IPs > Senders); a single verified address is enough, no domain needed.
BREVO_API_KEY=

# -----------------------------------------------------------------------------
# Option 3: Gmail API over HTTPS (MAIL_PROVIDER=gmail)
# -----------------------------------------------------------------------------
# Sends from the Gmail account itself (MAIL_FROM_EMAIL = that address). Google Cloud project with the Gmail API
# enabled, OAuth client of type "Desktop app"; then run `node scripts/gmail-refresh-token.cjs <ID> <SECRET>` once.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# -----------------------------------------------------------------------------
# Option 4: Standard SMTP Transport (Nodemailer)
# Works with AWS SES, SendGrid, Mailgun, Postmark, Brevo, or custom SMTP servers.
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Set to 'true' for port 465 (SSL/TLS), or 'false' for STARTTLS (port 587/2525)
SMTP_SECURE=false
SMTP_FROM=no-reply@sportexus.com

# Language of every e-mail the platform sends: en (default) or ar.
# MAIL_LOCALE=en

# Development only: return the password-reset code in the forgot-password response (default false).
# Never enable on a server reachable from the internet: anyone could reset any account.
# AUTH_EXPOSE_DEBUG_OTP=false

# Online payments (Paymob, Egypt). Online payment is offered only when the first four are set; use test keys and
# test integration ids until going live. Set NEXT_PUBLIC_APP_URL (or APP_PUBLIC_URL) to the public web address: the
# provider calls <app>/v1/payments/paymob/webhook and sends the payer back to <app>/payments/result.
# PAYMOB_SECRET_KEY=
# PAYMOB_PUBLIC_KEY=
# PAYMOB_HMAC_SECRET=
# PAYMOB_INTEGRATION_IDS=        # comma-separated, e.g. card and wallet integration ids
# PAYMOB_API_BASE=https://accept.paymob.com
# PAYMOB_CHECKOUT_URL=https://eg.checkout.paymob.com
# PAYMOB_CURRENCY=EGP
