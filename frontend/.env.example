NEXT_PUBLIC_APP_NAME=Academy Platform
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/v1

# Set INTERNAL_API_URL in production / containerized environments to point to the NestJS container/service
# INTERNAL_API_URL=http://api:3001

# Production only (see docs/deployment/RENDER.md): the same secret as the API, and the number of trusted proxy hops
# in front of this app (1 on Render).
# INTERNAL_PROXY_SECRET=
# WEB_TRUSTED_PROXY_HOPS=1
