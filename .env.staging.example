# =============================================================================
# SPORTEXUS — Staging Deployment Credentials (Git-Ignored)
# =============================================================================
# Copy this file to `.env.staging` (which is in .gitignore and never committed).
# Place your Hostless administrative PostgreSQL connection string below.
#
# It is used strictly by the deployment scripts to:
#   1. Verify database target is `sportexus-api-staging`.
#   2. Apply pending Prisma migrations (`prisma migrate deploy`).
#   3. Provision the unprivileged `sportexus_app` runtime role.
#   4. Execute security and RLS regression tests.
#
# Format:
# HOSTLESS_DATABASE_ADMIN_URL=postgresql://academy:<ADMIN_PASSWORD>@<HOST>:<PORT>/sportexus-api-staging?sslmode=require
# =============================================================================

HOSTLESS_DATABASE_ADMIN_URL=
