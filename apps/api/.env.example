NODE_ENV=development
PORT=3001
API_VERSION=0.0.0
DATABASE_URL=postgresql://academy:academy@localhost:5432/academy?schema=public
REDIS_URL=redis://localhost:6379

# =============================================================================
# SPORTEXUS EMAIL SYSTEM CONFIGURATION
# =============================================================================
# Provider selection: 'resend' | 'smtp' | 'dev'
# If left empty, auto-detects: 'resend' if RESEND_API_KEY is present,
# 'smtp' if SMTP_HOST is present, or defaults safely to 'dev' (in-memory logger).
MAIL_PROVIDER=dev

# Sender Identity
MAIL_FROM_EMAIL=no-reply@sportexus.com
MAIL_FROM_NAME="Sportexus Platform"

# Public Application URL (used for links in emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Option 1: Resend HTTP REST API
# -----------------------------------------------------------------------------
# Obtain your API key from https://resend.com/api-keys
RESEND_API_KEY=re_placeholder_secret_key

# -----------------------------------------------------------------------------
# Option 2: Standard SMTP Transport (Nodemailer)
# Works with AWS SES, SendGrid, Mailgun, Postmark, Brevo, or custom SMTP servers.
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Set to 'true' for port 465 (SSL/TLS), or 'false' for STARTTLS (port 587/2525)
SMTP_SECURE=false
SMTP_FROM=no-reply@sportexus.com
