# Copy to .env for local tooling that reads the repo root.
# Apps also have their own .env.example files.

DATABASE_URL=postgresql://academy:academy@localhost:5432/academy?schema=public
REDIS_URL=redis://localhost:6379

# =============================================================================
# SPORTEXUS EMAIL SYSTEM CONFIGURATION
# =============================================================================
MAIL_PROVIDER=dev
MAIL_FROM_EMAIL=no-reply@sportexus.com
MAIL_FROM_NAME="Sportexus Platform"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend API
RESEND_API_KEY=

# Standard SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=no-reply@sportexus.com
