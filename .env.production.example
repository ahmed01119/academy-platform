# Copy to .env.production on the host. Never commit the real file.

NODE_ENV=production
API_VERSION=0.1.0

POSTGRES_DB=academy
POSTGRES_USER=academy
POSTGRES_PASSWORD=change-me-strong-postgres-password
POSTGRES_RUNTIME_PASSWORD=change-me-runtime-password
# Runtime role must NOT be postgres/academy/root (see env.validation.ts)
DATABASE_URL=postgresql://academy_runtime:change-me-runtime-password@postgres:5432/academy?schema=public
DATABASE_ADMIN_URL=postgresql://academy:change-me-strong-postgres-password@postgres:5432/academy?schema=public

REDIS_URL=redis://redis:6379

JWT_SECRET=replace-with-32-plus-character-production-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
COOKIE_SECURE=true

# Comma-separated browser origins; no wildcards
CORS_ORIGIN=https://app.example.com
NEXT_PUBLIC_APP_NAME=Academy Platform
NEXT_PUBLIC_API_BASE_URL=https://api.example.com/v1
NEXT_PUBLIC_APP_URL=https://app.example.com

WEB_PORT=3000
API_PORT=3001
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
